<?xml version="1.0" encoding="UTF-8"?>
<robot name="turtlebot3_burger" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ===== MATERIALS ===== -->
  <material name="green">
    <color rgba="0 1 0 1"/>
  </material>

  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>

  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <xacro:arg name="namespace" default=""/>
  <xacro:property name="namespace" value="$(arg namespace)"/>

  <!-- ===== BASE ===== -->
  <link name="${namespace}base_footprint"/>

  <joint name="${namespace}base_joint" type="fixed">
    <parent link="${namespace}base_footprint"/>
    <child link="${namespace}base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}base_link">
    <visual>
      <origin xyz="-0.032 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/bases/burger_base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <!-- ===== LEFT WHEEL ===== -->
  <joint name="${namespace}wheel_left_joint" type="continuous">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}wheel_left_link"/>
    <origin xyz="0.0 0.08 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${namespace}wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/wheels/left_tire.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <!-- ===== RIGHT WHEEL ===== -->
  <joint name="${namespace}wheel_right_joint" type="continuous">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}wheel_right_link"/>
    <origin xyz="0.0 -0.080 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${namespace}wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/wheels/right_tire.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <!-- ===== CASTER ===== -->
  <joint name="${namespace}caster_back_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}caster_back_link"/>
    <origin xyz="-0.081 0 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="${namespace}caster_back_link"/>

  <!-- ===== IMU ===== -->
  <joint name="${namespace}imu_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}imu_link"/>
    <origin xyz="0 0 0.068" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}imu_link"/>

  <!-- ===== LIDAR (ARREGLADO) ===== -->
  <joint name="${namespace}scan_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}base_scan"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- ===== GROUND (RVIZ ONLY) ===== -->
  <link name="ground">
    <visual>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry>
        <box size="10 10 0.01"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="ground_joint" type="fixed">
    <parent link="${namespace}base_footprint"/>
    <child link="ground"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
